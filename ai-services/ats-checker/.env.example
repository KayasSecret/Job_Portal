# HireNest ATS Checker Microservice Configuration
APP_NAME=HireNest ATS Checker Service
APP_ENV=development
HOST=127.0.0.1
PORT=8001

# Allowed origins (restricted to local Express backend and local frontend dev server)
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173

# File validation limits
MAX_FILE_SIZE_MB=5
MAX_JOB_DESCRIPTION_CHARS=10000

# Shared internal secret between Node.js Express Backend and Python FastAPI Service
# Must match ATS_SERVICE_SECRET in Backend/.env
INTERNAL_SERVICE_SECRET=hirenest_internal_ats_secret_change_in_prod_2026
